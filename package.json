{
  "name": "software-testing-assignment",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "c8 mocha test/*.test.js --exit",
    "coveralls": "cat ./coverage/lcov.info | node node_modules/.bin/coveralls"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "c8": "^11.0.0",
    "coveralls": "^3.1.1",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0"
  },
  "c8": {
    "all": true,
    "src": "./src",
    "include": [
      "src/*.js"
    ],
    "exclude": [
      "src/.internal/**",
      "test/**"
    ],
    "reporter": [
      "text",
      "lcov"
    ],
    "report-dir": "./coverage"
  }
}
